{%
	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? '?');

	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">

{% include("themes/" + theme + "/head", { hostname: hostname, node: node, media: media, resource: resource, css: css, dispatcher: dispatcher, version: version, theme: theme, authenticated: false }) %}

<body>
